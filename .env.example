# Flagsmith Configuration
# Server-side environment key (keep secret, used by @flagsmith/nodejs)
FLAGSMITH_ENVIRONMENT_KEY=ser.xxxxxx
# Client-side environment key (safe for browser)
FLAGSMITH_CLIENT_ENV_KEY=xxxxxx
# Public Flags API URL (defaults to Edge API)
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/
# Flagsmith Management API Personal Access Token (PAT) for programmatically setting winner / rollback
FLAGSMITH_MANAGEMENT_API_KEY=
# Numeric environment ID in Flagsmith (found in Environment Settings)
FLAGSMITH_ENVIRONMENT_ID=
# Numeric feature ID for 'defense_variant'
FLAGSMITH_FEATURE_ID=
# Multivariate Option IDs for variants in Flagsmith
FLAGSMITH_HARDENED_MV_ID=
FLAGSMITH_LURIEN_MV_ID=

# Google Gemini API (Server-side only)
GEMINI_API_KEY=

# Lurien Matrix Firewall (Optional external guardrail API)
LURIEN_API_URL=http://localhost:8000
LURIEN_API_KEY=lurien-secret-key

# Database (libsql / Turso or local SQLite)
# Production: set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN (takes precedence)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local development fallback
DATABASE_URL=file:./pwnlab.db
DATABASE_AUTH_TOKEN=
# Separate database for developer simulation script (scripts/dev-sim.ts)
DEV_DATABASE_URL=file:./pwnlab-dev.db

# Admin & Ship Gate Controls
ADMIN_PASSWORD=changeme
SHIP_APPROVAL_TTL_HOURS=24
CRON_SECRET=supersecretcronkey

# Experiment Configuration & Statistical Boundaries (Option A: 2 arms)
EXPERIMENT_MIN_SAMPLE=75
EXPERIMENT_MAX_BREACH_RATE=0.15
EXPERIMENT_MAX_LATENCY_P95=5000
EXPERIMENT_MAX_COST_PER_TURN=0.01

# Public Client-side variables (exposed to Next.js browser bundle)
NEXT_PUBLIC_FLAGSMITH_CLIENT_ENV_KEY=
NEXT_PUBLIC_FLAGSMITH_DASHBOARD_URL=https://app.flagsmith.com/
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Git Commit Hash of hypothesis.md for pre-registration verification
# Set to the output of: git log --format='%H' -1 -- hypothesis.md
PREREG_COMMIT=
HYPOTHESIS_COMMIT_HASH=
